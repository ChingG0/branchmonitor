{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "strict": true, "noEmit": true, "isolatedModules": true,
    "esModuleInterop": true, "resolveJsonModule": true, "types": ["vite/client"]
  },
  "include": ["frontend/src/**/*.ts", "frontend/src/**/*.vue", "vite.config.ts"]
}
